+static int mp_property_sbtl_buffer(void *ctx, struct m_property *prop,
+                                   int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (!mpctx->playback_initialized || !mpctx->demuxer)
+        return M_PROPERTY_UNAVAILABLE;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_NODE};
+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+
+    struct demux_reader_state state;
+    demux_get_reader_state(mpctx->demuxer, &state);
+    if (!state.sbtl_buffer_valid)
+        return M_PROPERTY_UNAVAILABLE;
+
+    const struct demux_sbtl_buffer *buffer = &state.sbtl_buffer;
+    const char *level = buffer->level == DEMUX_SBTL_BUF_STALLED ? "stalled" :
+                        buffer->level == DEMUX_SBTL_BUF_LOW ? "low" :
+                        buffer->level == DEMUX_SBTL_BUF_READY ? "ready" : "full";
+    const char *reason = state.seeking != MP_NOPTS_VALUE ? "seek" :
+                         !mpctx->restart_complete ? "initial" :
+                         buffer->level >= DEMUX_SBTL_BUF_READY &&
+                             buffer->ahead_ms >= (uint32_t)mpctx->opts->sbtl_ready_ms ? "none" :
+                         buffer->level == DEMUX_SBTL_BUF_STALLED ? "stall" : "low";
+    const char *status = state.seeking != MP_NOPTS_VALUE ? "seeking" :
+                         !mpctx->restart_complete ? "loading" :
+                         buffer->level >= DEMUX_SBTL_BUF_READY &&
+                             buffer->ahead_ms >= (uint32_t)mpctx->opts->sbtl_ready_ms ? "ready" :
+                         buffer->stalled_ms >= 4000 && buffer->fill_rate == 0 ? "waiting-peers" : "buffering";
+
+    struct mpv_node *node = arg;
+    node_init(node, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_string(node, "state", status);
+    node_map_add_string(node, "reason", reason);
+    node_map_add_string(node, "level", level);
+    node_map_add_int64(node, "ahead_ms", buffer->ahead_ms);
+    node_map_add_int64(node, "ready_ms", mpctx->opts->sbtl_ready_ms);
+    if (buffer->eta_ready_ms == UINT32_MAX)
+        node_map_add(node, "eta_ready_ms", MPV_FORMAT_NONE);
+    else
+        node_map_add_int64(node, "eta_ready_ms", buffer->eta_ready_ms);
+    node_map_add_int64(node, "fill_rate", buffer->fill_rate);
+    node_map_add_int64(node, "stalled_ms", buffer->stalled_ms);
+    node_map_add_flag(node, "rate_known", buffer->rate_known);
+    return M_PROPERTY_OK;
+}
