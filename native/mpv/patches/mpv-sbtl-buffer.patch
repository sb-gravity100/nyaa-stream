+static bool update_sbtl_buffer_snapshot(struct MPContext *mpctx,
+                                        const struct demux_reader_state *state)
+{
+    bool changed = mpctx->sbtl_buffer_seen != state->sbtl_buffer_valid;
+    if (state->sbtl_buffer_valid) {
+        struct demux_sbtl_buffer *old = &mpctx->sbtl_buffer_last;
+        const struct demux_sbtl_buffer *cur = &state->sbtl_buffer;
+        changed |= old->ahead_ms != cur->ahead_ms ||
+                   old->ready_ms != cur->ready_ms ||
+                   old->eta_ready_ms != cur->eta_ready_ms ||
+                   old->fill_rate != cur->fill_rate ||
+                   old->stalled_ms != cur->stalled_ms ||
+                   old->level != cur->level ||
+                   old->rate_known != cur->rate_known;
+        mpctx->sbtl_buffer_last = *cur;
+    }
+    mpctx->sbtl_buffer_seen = state->sbtl_buffer_valid;
+    return changed;
+}
