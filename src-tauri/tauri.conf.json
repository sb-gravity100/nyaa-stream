{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nyaa-stream",
  "version": "0.4.2",
  "identifier": "com.nyaastream.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nyaa-stream",
        "width": 1100,
        "height": 720,
        "maximized": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "nyaa-stream",
        "url": "splash.html",
        "width": 360,
        "height": 400,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {"lib/*": "lib/", "../native/sbtl/sbtl.dll": "sbtl.dll"},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "bannerPath": "installer/banner.bmp",
        "dialogImagePath": "installer/dialog.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4ODJBRTE2OUE1ODQ5MUYKUldRZlNWaWFGcTZDU0F1RzkzU0ZhVFJqZXI5bkJWOXpoRGdldWxId21Ra0JQcVZtRTBUcnQ2YVYK",
      "endpoints": ["https://github.com/sb-gravity100/nyaa-stream/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
